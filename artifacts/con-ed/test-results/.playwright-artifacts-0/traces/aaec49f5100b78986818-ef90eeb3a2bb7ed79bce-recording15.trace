{"type":"before","callId":"call@1327","startTime":127220.779,"class":"Frame","method":"evaluateExpression","params":{"expression":"async({signInParams:r,windowObject:i})=>{try{let s=i||window;if(!s.Clerk.client)return;let e=s.Clerk.client.signIn;switch(r.strategy){case\"password\":{let o=await e.create(r);await s.Clerk.setActive({session:o.createdSessionId});break}case\"ticket\":{let o=await e.create({strategy:\"ticket\",ticket:r.ticket});if(o.status===\"complete\")await s.Clerk.setActive({session:o.createdSessionId});else throw new Error(`Sign-in with ticket failed. Status: ${o.status}`);break}case\"phone_code\":{if(!/^\\+1\\d{3}55501\\d{2}$/.test(r.identifier))throw new Error(`Phone number should be a test phone number.\n\n       Example: +1XXX55501XX.\n\n       Learn more here: https://clerk.com/docs/testing/test-emails-and-phones#phone-numbers`);let{supportedFirstFactors:o}=await e.create({identifier:r.identifier}),n=o?.find(t=>t.strategy===\"phone_code\");if(n){await e.prepareFirstFactor({strategy:\"phone_code\",phoneNumberId:n.phoneNumberId});let t=await e.attemptFirstFactor({strategy:\"phone_code\",code:\"424242\"});if(t.status===\"complete\")await s.Clerk.setActive({session:t.createdSessionId});else throw new Error(`Status is ${t.status}`)}else throw new Error(\"phone_code is not enabled.\");break}case\"email_code\":{if(!r.identifier.includes(\"+clerk_test\"))throw new Error(`Email should be a test email.\n\n       Any email with the +clerk_test subaddress is a test email address.\n\n       Learn more here: https://clerk.com/docs/testing/test-emails-and-phones#email-addresses`);let{supportedFirstFactors:o}=await e.create({identifier:r.identifier}),n=o?.find(t=>t.strategy===\"email_code\");if(n){await e.prepareFirstFactor({strategy:\"email_code\",emailAddressId:n.emailAddressId});let t=await e.attemptFirstFactor({strategy:\"email_code\",code:\"424242\"});if(t.status===\"complete\")await s.Clerk.setActive({session:t.createdSessionId});else throw new Error(`Status is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzgyNDk4MjgwLCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNGZ1kzYmxXUEkwV2swQVBzdEpCOHREOWE3ZyIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.D1VQC7q74g7q14gmrEn3uVZPGQFGtI61eX5qkskzwEpYAsRDlWHb508B9KO56birieDllhcu89tScbcB2KFyIsalNwdr53oVxy6kXKYk9ST3Xa9LK1GDLuh-L4K4Q2ln9pdWfeXaXi3hcQR406cVAzStv9-r4l0h7cN37IEsMqB9qDklVGyx6UUC54ENSeLZl1RegOD3DhEKkbJB43em_NduuA0fIW8y-8DZObs1p504rcg3kaLR2hp659kvrehpxlnTTqLHrA6-XCutYftKLWMKl09qgAPvomaC5QQkxnGMCgCCv4ysXhV3oUHoPFWpsACCn6G-uFcf1NuR8Fpahg"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@45","pageId":"page@bc6d56871aca94bee02f030c6799028d","beforeSnapshot":"before@call@1327"}
