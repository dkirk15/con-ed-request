s is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzg0NTYwMzg0LCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNHbHhpY21zaVR1RkdKVWZJN0lGNmtjVWlVVyIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.gFTr50AHOTnCTXR1LY-ZcWIj5VPynhbwoI70RRWOTolkd0AFkyEhGlWTAw-ynGdWL7X93S99JDoKdakBVKmDyRz2qlAWHwFlJNX2XU0iPxZRlOd0gPmWFZ79CqvMr0yBMymKMlaUIqROLDpO_V6wStBXIvEcPxXQZ0GRbs3uDBSIChQR-HdyJAKCL78L3wgwxMm6arzCXRt77r9y1M9mkzQdFvbfy9kKMD1o--VsPu9a8pU31PAbJgIuMWKHbHqdH1X-9LoNyBL96XAggNxhME2GlHYXFc3_KIPOzLSb1byG-DVAkOJigvQFGREGnjDpvZ05lF4fwya3y0oet9tieQ"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@46","pageId":"page@12a81a7c72460a8f1cd2eac4eec41e00","beforeSnapshot":"before@call@129"}
