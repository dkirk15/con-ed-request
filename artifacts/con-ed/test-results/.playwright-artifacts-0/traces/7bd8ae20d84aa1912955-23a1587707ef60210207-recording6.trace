s is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzgyNTI5MzEzLCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNGaFl4TFhZcE1XYXhPb29kclVkVzVZSkRFcyIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.TzuWB7NEzVbTmVXAOPiqK_ESNiaTPoPexv4zuppxEyUta19HNoeUFfg2hKmy7V2r13K1riHnRdTgd3jZwsBSGggI-5B-z90IQjPmmd52JfebY7tGn75WfCcMJ-bwLkhMFpEcL7LNa1Fj6iAW-PA5HDF_uxm2-dv6IeXVnBH38kEYBahyBeC0sPhtUfzwJ3EyLBXzJT2HvCo1pIq8FNo8CIfya1SOp4nBo6gBczCIeFgT_QAhmfcqCFY5Wd_oQh_yeDAgwY13f99BR2jRtdNO8pqywrvySbWMjYopX6y0DDQxruCd6LZyMw9pgla5Pz200UGojf8cQo0gkPFSfYDgxQ"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@45","pageId":"page@f2d5095f71130be8d11de0168adc37e8","beforeSnapshot":"before@call@553"}
