s is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzgyNDk4MjE4LCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNGZ1h2bmJCUTJKZHBWZkhmWm01NmpPaWpScSIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.Bnn7ZE8JzaHf6AszZ7lriwcpW1Cz4ooLuFWoU2Cy29sWOOfctg9jvk3RVEdfADd8f67NzN0GqQzBkG1t0HWlt3E_OOQc9WvLdTaqmLAtpCvtqFyyP4WXHfJwruQQ74nQIby3hV2bGZgN_WR8NuMKAtDa9y7Q8LXnyQdwz6zLN9WID1Ce51XWG-Bp2icpWQPLSazPknoyyznAcHcvchGb5MlLdrijcSg_jUVWMPeD9fmJG6ivLatV6rV7capDvfgvBJzZplYHSBbUeTTXUgRxhtWXeSQ3cLmZLV4f8kiy4Hn5uvhYeEmrDl4dBcyr1IWK8PgbyOiZ64Xq2EaWGHbluw"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@46","pageId":"page@4fb1456e4a6bce0b1620c84b63046631","beforeSnapshot":"before@call@651"}
