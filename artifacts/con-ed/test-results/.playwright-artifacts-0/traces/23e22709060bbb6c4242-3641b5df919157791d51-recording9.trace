s is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzgyNDk4MjM0LCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNGZ1h4ajFUTTEwWDR4dlM1NHNOUG1DMDJ3aCIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.DJJRSa5nc_JQflU0LFolmweQfH65SWpR652odsA8ZCJiDNBdqnZTkINTa7Ttn80XlioqYzStky2GczaVZaRzCRlLqc1lAnMDCPTucMg8ey-Jp1yqFJWrpnQhzdfZYTD6i2cNil4S7nlSpr_oRjsj1mzibPgZgzprKoKVkYjVLxIXNQfe4Wzvk4iXBWzo5vH8jAYXCRyG6vIusV7I-15eXGir46UkIlnXry0LnBIcCLeSQi24PsyqwEScN10G-iDQmgJFX2IKyuN9z3IfpayXdi1OEjed8bk4N_hSZFT2y9qmr0wB39GSLOCaKzt4O-SW990QhvqFZOBsPuhY_bKBYA"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@45","pageId":"page@79b0bb6cbbe0f02af06b2f7e04c7d7e0","beforeSnapshot":"before@call@825"}
