{"type":"before","callId":"call@439","startTime":90189.319,"class":"Frame","method":"evaluateExpression","params":{"expression":"async({signInParams:r,windowObject:i})=>{try{let s=i||window;if(!s.Clerk.client)return;let e=s.Clerk.client.signIn;switch(r.strategy){case\"password\":{let o=await e.create(r);await s.Clerk.setActive({session:o.createdSessionId});break}case\"ticket\":{let o=await e.create({strategy:\"ticket\",ticket:r.ticket});if(o.status===\"complete\")await s.Clerk.setActive({session:o.createdSessionId});else throw new Error(`Sign-in with ticket failed. Status: ${o.status}`);break}case\"phone_code\":{if(!/^\\+1\\d{3}55501\\d{2}$/.test(r.identifier))throw new Error(`Phone number should be a test phone number.\n\n       Example: +1XXX55501XX.\n\n       Learn more here: https://clerk.com/docs/testing/test-emails-and-phones#phone-numbers`);let{supportedFirstFactors:o}=await e.create({identifier:r.identifier}),n=o?.find(t=>t.strategy===\"phone_code\");if(n){await e.prepareFirstFactor({strategy:\"phone_code\",phoneNumberId:n.phoneNumberId});let t=await e.attemptFirstFactor({strategy:\"phone_code\",code:\"424242\"});if(t.status===\"complete\")await s.Clerk.setActive({session:t.createdSessionId});else throw new Error(`Status is ${t.status}`)}else throw new Error(\"phone_code is not enabled.\");break}case\"email_code\":{if(!r.identifier.includes(\"+clerk_test\"))throw new Error(`Email should be a test email.\n\n       Any email with the +clerk_test subaddress is a test email address.\n\n       Learn more here: https://clerk.com/docs/testing/test-emails-and-phones#email-addresses`);let{supportedFirstFactors:o}=await e.create({identifier:r.identifier}),n=o?.find(t=>t.strategy===\"email_code\");if(n){await e.prepareFirstFactor({strategy:\"email_code\",emailAddressId:n.emailAddressId});let t=await e.attemptFirstFactor({strategy:\"email_code\",code:\"424242\"});if(t.status===\"complete\")await s.Clerk.setActive({session:t.createdSessionId});else throw new Error(`Status is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzgyMTY1MjU2LCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNGVmYzR21aUHI0anVMd3NBamJxOEtTRW1iTyIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.XGJgB_YY5tLkrOfmEv3qOYxaTnb1QkpeFufT6fJPvH3crDpm_x4O7mez7Ix_0Z6kFouBqNfzerU5FZCOLggD4YDaWEAEbq2HudJyE8wt_ugiTH4eHaj1juBQzn_I0xsUTB1epz3voVtJIctkjzMRF2ohOF8P9jlx3tecKG93VCbUXhdvKlJ0JV9RVJ4U-fAmjr2F5i9XDLnyduQ24T_NEGXwCORDvVGaNAk2BH8wFuBlETX-yTHsrqFR5E8A1MsbLQ7i1BcTo_m-YAYsPDiSbsa7GGbQrPe7iMh9IishtNIq9Lod9vJe05rZC2sm9TGwuHgtcbpGRNi-avvsgeo3NQ"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@44","pageId":"page@e47a94fd79a92e0b08b3acc29be814a4","beforeSnapshot":"before@call@439"}
