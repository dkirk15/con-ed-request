s is ${t.status}`)}else throw new Error(\"email_code is not enabled.\");break}default:throw new Error(`Unsupported strategy: ${r.strategy}`)}}catch(s){throw new Error(`Clerk: Failed to sign in: ${s?.message}`)}}","isFunction":true,"arg":{"value":{"o":[{"k":"signInParams","v":{"o":[{"k":"strategy","v":{"s":"ticket"}},{"k":"ticket","v":{"s":"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJlaXMiOjMwMCwiZXhwIjoxNzgyMTY1MjQxLCJpaWQiOiJpbnNfM0ZUUGZMdUJEa1VNZk1Ydm5aVlRJU2pzNlZTIiwic2lkIjoic2l0XzNGVmYxUHNpeVM1ek1lSE03SEVRdTdEZXVRYiIsInN0Ijoic2lnbl9pbl90b2tlbiJ9.BjQfBk1gL-Fkk0ctDs8R7KJDtn0_vupTxKFCQVSlTRHmkJsezRiiGM6AqIh6qNNBSoIBojkFYdEGZ6g_IBWPpyA52s0aoSW0qZ1LMEgZEtRxg4oU2bpc0JdvySE_BYGu-Wre_F-abl55gans8isa4CWavlti1ftHey1HJ2UgXGgw7M2NW88IcEjeJkAzsQBu-ftqgGvjqWydR6biD8NYqpfqIokJBC-N0AYdgPQbQOsvCzAO8aZXhbdDr85vOZcIgmKKmFLF0Roj17LqXhs_oqDpC9WdYniDMiTa2VD4IEBHsruFLX8B0pg5_hJIOXwe-o7dpWQU3Tw2j9hmGXGYrg"}}],"id":2}}],"id":1},"handles":[]}},"stepId":"pw:api@44","pageId":"page@35fc8234db16002581e234f9e4d9bdfd","beforeSnapshot":"before@call@369"}
