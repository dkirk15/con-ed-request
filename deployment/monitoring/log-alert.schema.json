{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production log alert contract",
  "type": "object",
  "required": [
    "service",
    "source",
    "match",
    "aggregation",
    "notification"
  ],
  "properties": {
    "service": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "format",
        "stream"
      ],
      "properties": {
        "format": {
          "const": "json"
        },
        "stream": {
          "const": "stdout"
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "levelAtLeast",
        "event"
      ],
      "properties": {
        "levelAtLeast": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "const": "auth.clerk_provisioning_lookup_failure"
        }
      },
      "additionalProperties": false
    },
    "aggregation": {
      "type": "object",
      "required": [
        "count",
        "windowSeconds",
        "groupBy",
        "deduplicationKey",
        "cooldownSeconds",
        "alertEvent"
      ],
      "properties": {
        "count": {
          "const": 5
        },
        "windowSeconds": {
          "const": 300
        },
        "groupBy": {
          "const": [
            "service",
            "event"
          ]
        },
        "deduplicationKey": {
          "const": "event"
        },
        "cooldownSeconds": {
          "const": 900
        },
        "alertEvent": {
          "const": "alert.auth.clerk_provisioning_lookup_failures"
        }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": [
        "recipient",
        "cooldownSeconds",
        "deduplicationKey",
        "message",
        "includeFields",
        "excludePaths"
      ],
      "properties": {
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "cooldownSeconds": {
          "const": 900
        },
        "deduplicationKey": {
          "const": "event"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "includeFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}